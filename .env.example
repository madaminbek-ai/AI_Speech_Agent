# Free local processing is the default. OpenAI is optional and never a fallback.
AI_BACKEND=local
WHISPER_MODEL=small
# Empty: autodetect; uz: Uzbek; ru: Russian (avoid forcing a language on mixed calls).
WHISPER_LANGUAGE=
HF_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=900
OLLAMA_NUM_CTX=16384
LOCAL_CPU_THREADS=4
LOCAL_MAX_AUDIO_SECONDS=1800
LOCAL_MAX_TRANSCRIPT_CHARS=16000

OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
